// mem-plus 注册示例 —— 可直接抄进 opencode.jsonc
//
// 这里只管"怎么让 OpenCode 加载插件"。mem-plus 的设置不在这里，写在
// ~/.config/opencode/mem-plus/config.jsonc（首次运行时自动生成，带注释模板），
// 那样自动发现和显式注册两种方式都能配置。
//
// 只留 "plugins": ["路径"] 一行也能跑。

{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    // 指向插件目录（含 package.json 与 index.ts 的那一层），不可填内层 plugin/。
    // Windows 下用正斜杠 /。
    "C:/Users/你的用户名/.config/opencode/plugins/mem-plus"
  ]
}

// ⚠️ mem-plus 只能被加载一次。上面这条与"把目录放在 ~/.config/opencode/plugins/
//    下让 OpenCode 自动发现"是两种加载方式，选一种即可。同时用会让 OpenCode 加载
//    两份：日志出现两条 plugin loaded，工具重复注册，同一轮对话写两份快照。
//
// 也可写成对象并附带 options（仍然可用，但优先级低于 config.jsonc）：
//
//   "plugins": [
//     {
//       "package": "C:/path/to/mem-plus",
//       "options": { "model": { "content": "opencode" } }
//     }
//   ]
